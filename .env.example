# Intelligent Logistics ETA Prediction System Environment Configuration
ENV=development
RANDOM_SEED=20261022

# Database Connection (Default is SQLite file, or PostgreSQL when running in Docker/production)
DATABASE_URL=sqlite:///data/logistics.db
POSTGRES_DB=logistics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Streamlit Dashboard Configuration
STREAMLIT_PORT=8501
API_URL=http://localhost:8000

# Prediction & Alert Configuration
DEFAULT_DELAY_THRESHOLD_MINUTES=30
ALERT_PROBABILITY_THRESHOLD=0.65
MAX_REMAINING_HOURS_HORIZON=168
